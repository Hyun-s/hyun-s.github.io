# AI Job Crawler Configuration Template
# 1. 이 파일을 '.env'로 복사한 뒤 본인의 값을 입력하세요.
# 2. .env 파일은 .gitignore에 등록되어 있어 안전하게 보호됩니다.

# Google Gemini / LLM Configuration (로컬 사용 시 무시됨)
GEMINI_API_KEY=your_gemini_api_key

# Google Calendar Configuration
CALENDAR_ID=your_calendar_id@gmail.com
# GCP_CREDENTIALS는 JSON 내용 전체를 한 줄로 입력해야 합니다.
GCP_CREDENTIALS={"type": "service_account", ...}

# Discord Configuration
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
